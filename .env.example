# 이 파일을 .env로 복사해 실제 값을 넣는다. .env는 저장소에 올리지 않는다.
# 값에 $ 같은 특수문자가 있으면 작은따옴표로 감싼다.

DOCKERHUB_USER=shj6341
IMAGE_TAG=latest

# 배포 도메인 (https:// 없이). Caddy가 HTTPS 인증서를 자동으로 받는다.
SITE_ADDRESS=example.duckdns.org

# Supabase의 Session pooler 주소
DATABASE_URL=
# 로컬과 다른 새 값 (32자 이상)
JWT_SECRET=

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://example.duckdns.org/auth/kakao/callback
VITE_KAKAO_CLIENT_ID=

OPENAI_API_KEY=
